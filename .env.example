# Copy to .env and replace both values with your own Supabase project settings.
# These two values are public and are bundled into the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Never add GEMINI_API_KEY, a database password or a Supabase secret key here.
